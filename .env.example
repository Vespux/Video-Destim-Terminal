# Recommended setup: run `bash setup.sh` from the project directory.
# Manual setup remains supported by copying/editing this file as .env.
# Required: create your own Google Cloud API key and restrict it to YouTube Data API v3.
# Leave this blank until you are ready to add your own key.
YOUTUBE_API_KEY=

# CHOOSE OVERRIDE PIN: replace the placeholder with exactly four digits.
# This is a cooldown override PIN, NOT login/authentication.
OVERRIDE_PIN=CHOOSE_4_DIGITS

# Optional application tuning.
CACHE_TTL_SECONDS=900
MAX_PLAYLIST_PAGES=4

# Network binding. 127.0.0.1 is the safe default; use an HTTPS reverse proxy or Tailscale Serve.
VIDEO_DESTIM_BIND=127.0.0.1
VIDEO_DESTIM_PORT=8790
